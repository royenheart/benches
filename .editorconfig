root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hpp,hxx,cu,cuh}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.lua]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
