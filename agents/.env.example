# DeepSeek API Configuration
# Copy this file to agents/.env and fill in your API key:
#   cp agents/.env.example agents/.env
#
# agents/.env is gitignored — never commit your real API key.
#
# Docs: https://api-docs.deepseek.com/zh-cn/

# DeepSeek API base URL (OpenAI-compatible, NO /v1 suffix)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Your DeepSeek API key — get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here

# API endpoint style (default: chat):
#   chat      — OpenAI Chat Completions  /chat/completions（默认，demo 全兼容）
#   responses — OpenAI Responses API     /responses（官方三端点之一；返回结构不同，client 已适配）
# Can be overridden per call: chat(..., api="responses")
#DEEPSEEK_API=chat

# Model selection:
#   deepseek-flash (= deepseek-v4-flash 别名，V4.1 统一智能模式：快速/专家/识图已合并)
#   deepseek-v4-pro  — most capable (1M context, thinking modes)
#
# NOTE: deepseek-chat & deepseek-reasoner stopped 2026/07/24.
DEEPSEEK_MODEL=deepseek-flash

# Optional: model for complex reasoning tasks
# DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# Max tokens per request (default: 4096, max: 384K for V4 models)
# NOTE: V4.1 unified mode runs reasoning by default — reasoning tokens consume
#   max_tokens FIRST. Budgets below ~512 can return empty content (finish_reason=length).
#   llm_client.chat() auto-retries once with a larger budget on empty content.
DEEPSEEK_MAX_TOKENS=4096

# Temperature (0.0-2.0, default: 0.7)
DEEPSEEK_TEMPERATURE=0.7

# Thinking mode for deepseek-v4-pro (set to "enabled" to activate)
# When enabled, the model will output its reasoning process before the final answer.
# See: https://api-docs.deepseek.com/zh-cn/guides/thinking_mode
# DEEPSEEK_THINKING=enabled

# Reasoning effort level (requires thinking=enabled)
# Options: "low", "medium", "high"
# DEEPSEEK_REASONING_EFFORT=high
